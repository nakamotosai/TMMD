{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Sai Reader main window capabilities（纯阅读：目录树/读文件/单文件打开）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:window:allow-set-effects",
    "allow-set-glass-material",
    "core:app:default",
    "core:path:default",
    "allow-desktop-info",
    "allow-open-path",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-list-md-tree",
    "allow-read-text",
    "allow-write-text",
    "allow-save-path",
    "allow-load-roots",
    "allow-save-roots",
    "allow-pending-open"
  ]
}