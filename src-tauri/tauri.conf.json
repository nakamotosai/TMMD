{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMMD",
  "version": "1.9.3",
  "identifier": "com.saaaai.tmmd",
  "build": {
    "frontendDist": "../ui-reader",
    "beforeBuildCommand": "powershell -NoProfile -Command \"exit 0\"",
    "beforeDevCommand": "powershell -NoProfile -Command \"exit 0\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TMMD",
        "minWidth": 520,
        "minHeight": 360,
        "width": 520,
        "height": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "shadow": true,
        "additionalBrowserArgs": "--ignore-gpu-blocklist --enable-zero-copy"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Viewer",
        "description": "Open Markdown documents with TMMD"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
